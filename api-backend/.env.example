# ==============================================================================
# ParkFlow /api-backend — Configuración de Entorno (INT-SW-01 / RNF-01 / RNF-02)
# ==============================================================================

PARKFLOW_INFERENCE_SCHEMA_PATH=../contracts/json-schema/inference-state.schema.json
# Opcional: si se define, /api/v1/inference/states exige cabecera X-Internal-API-Key
PARKFLOW_INTERNAL_API_KEY=
# Umbral SLA de latencia de ingestión en milisegundos (RNF-01 <= 5000 ms)
PARKFLOW_LATENCY_SLA_MS=5000

# Seguridad JWT (RNF-02)
PARKFLOW_JWT_SECRET_KEY=parkflow-itm-dummy-secret-key-CAMBIAR-EN-PRODUCCION
PARKFLOW_JWT_ALGORITHM=HS256
PARKFLOW_JWT_EXPIRE_MINUTES=60

# Base de datos PostgreSQL 16
PARKFLOW_DATABASE_URL=postgresql+psycopg://parkflow:parkflow_password@localhost:5433/parkflow
