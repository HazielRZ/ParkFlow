# ==============================================================================
# ParkFlow /cv-service — Configuración de Entorno (PF-14 & PF-15)
# ==============================================================================

# --- Conexión con /api-backend (INT-SW-01 / RNF-01) ---
PARKFLOW_BACKEND_URL=http://127.0.0.1:8000
# Opcional: si se define en /api-backend, debe coincidir para autenticar el emisor interno
PARKFLOW_INTERNAL_API_KEY=
PARKFLOW_INFERENCE_SCHEMA_PATH=../contracts/json-schema/inference-state.schema.json

# --- Captura y Polígonos Calibrados (PF-14 / OT-01) ---
# Opciones: rtsp://user:pass@ip:554/stream | 0 (webcam) | path/video.mp4 | synthetic:day | synthetic:night_rain
PARKFLOW_VIDEO_SOURCE=synthetic:day
PARKFLOW_TARGET_FPS=5.0
PARKFLOW_POLYGONS_PATH=./config/polygons_itm_campus1.json

# --- Detector YOLO y Preprocesamiento Nocturno/Lluvia (OT-01 / RNF-07) ---
PARKFLOW_YOLO_MODEL=yolov8n.pt
PARKFLOW_YOLO_CONFIDENCE=0.45
PARKFLOW_YOLO_IMGSZ=640
PARKFLOW_YOLO_DEVICE=
# auto | always | off
PARKFLOW_PREPROCESS_MODE=auto
PARKFLOW_NIGHT_LUMA_THRESHOLD=85.0
PARKFLOW_NIGHT_GAMMA=1.35
PARKFLOW_CLAHE_CLIP_LIMIT=2.5

# --- Máquina de Estados Temporal e Histéresis (PF-14) ---
PARKFLOW_IOU_FREE_THRESHOLD=0.20
PARKFLOW_IOU_OCCUPIED_THRESHOLD=0.50
PARKFLOW_T_FREE_SECONDS=2.0
PARKFLOW_T_OCCUPIED_SECONDS=3.0
PARKFLOW_MIN_OCCUPIED_FRAMES=2
PARKFLOW_MIN_FREE_FRAMES=2
PARKFLOW_MANEUVER_DEBOUNCE_FRAMES=1

# --- Emisor Asíncrono de Deltas JSON (PF-15 / RNF-01 <= 5 s) ---
PARKFLOW_DELTA_DEBOUNCE_FRAMES=2
PARKFLOW_DELTA_EMIT_INITIAL=true
PARKFLOW_HTTP_TIMEOUT_SECONDS=1.5
PARKFLOW_HTTP_MAX_RETRIES=3
PARKFLOW_HTTP_BACKOFF_BASE_SECONDS=0.15
PARKFLOW_HTTP_BACKOFF_MAX_SECONDS=1.0
PARKFLOW_PUBLISHER_QUEUE_SIZE=256
